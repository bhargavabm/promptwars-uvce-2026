GEMINI_API_KEY=your_gemini_api_key_here
MAX_TRANSFER_LIMIT=50000
PORT=5000

# Authentication (single user, session-based)
# Generate a hash with:
#   python -c "from app import hash_password; print(hash_password('your-password'))"
BANKISM_USERNAME=demo_user
BANKISM_PASSWORD_HASH=pbkdf2_sha256$210000$replace_with_generated_value
# Long random string. If unset, an ephemeral key is generated (sessions reset on restart).
BANKISM_SECRET_KEY=replace_with_a_long_random_string
# Set to true only when served over HTTPS.
BANKISM_COOKIE_SECURE=false
